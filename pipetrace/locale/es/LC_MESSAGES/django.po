msgstr "Demostración:"

msgid ""
"Millbrook is a fictional town. Every address and pipe on this site is made "
"up."
msgstr ""
"Millbrook es un pueblo ficticio. Todas las direcciones y tuberías de este "
"sitio son inventadas."

msgid "Lead service line lookup"
msgstr "Consulta de líneas de servicio de plomo"

msgid "Main"
msgstr "Principal"

msgid "Look up an address"
msgstr "Buscar una dirección"

msgid "Check your pipe"
msgstr "Revise su tubería"

msgid "Filters"
msgstr "Filtros"

msgid "Questions"
msgstr "Preguntas"

msgid "On this site"
msgstr "En este sitio"

msgid "Browse by street"
msgstr "Ver por calle"

msgid "Request an inspection"
msgstr "Solicitar una inspección"

