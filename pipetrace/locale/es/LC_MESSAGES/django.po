msgstr ""
"Los archivos .xls antiguos no se pueden leer. Guarde el archivo como .xlsx "
"o .csv y vuelva a subirlo."

msgid "Upload an .xlsx or .csv file."
msgstr "Suba un archivo .xlsx o .csv."

#, python-format
msgid "Files must be smaller than %(mb)s MB."
msgstr "Los archivos deben pesar menos de %(mb)s MB."

msgid "Update the inventory: set the customer-side material for this line"
msgstr ""
"Actualizar el inventario: fijar el material del lado del cliente para esta "
"línea"

msgid "What the photo shows"
msgstr "Lo que muestra la foto"

msgid "Choose the material before updating the inventory."
msgstr "Elija el material antes de actualizar el inventario."

msgid "This photo isn't linked to a line in the inventory."
msgstr "Esta foto no está vinculada a ninguna línea del inventario."

