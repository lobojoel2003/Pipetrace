msgstr "Inventario actualizado: %(address)s ahora es “%(status)s”."

msgid "Page not found"
msgstr "Página no encontrada"

msgid "We couldn't find that page"
msgstr "No encontramos esa página"

msgid ""
"The address may have changed. Try looking up your street address instead."
msgstr ""
"Es posible que la dirección haya cambiado. Pruebe a buscar la dirección de "
"su casa."

msgid "Go to the home page"
msgstr "Ir a la página de inicio"

